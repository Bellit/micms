---
// Página propia del gestor, para webs sin panel. Si la web tiene uno, se usa el suyo (opción `layout`).
interface Props {
  title: string;
  actual?: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Gestor de contenido</title>
  </head>
  <body class="micms-base">
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  .micms-base {
    margin: 0;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.5;
    color: #1d1d1f;
    background: #f7f7f8;
  }
  .micms-base main { max-width: 900px; margin: 0 auto; padding: 24px 16px; }
</style>
